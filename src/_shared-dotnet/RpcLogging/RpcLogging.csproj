<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Hipstershop.RpcLogging</RootNamespace>
    <AssemblyName>Hipstershop.RpcLogging</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <!-- Provides the Activity.RecordException extension method used by
         M3.1 in RpcLoggingInterceptor. cartservice already references the
         same package; this avoids cross-project version drift. -->
    <PackageReference Include="OpenTelemetry.Api" Version="1.9.0" />
  </ItemGroup>

</Project>
